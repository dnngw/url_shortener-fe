# Copy this file to .env and adjust the values: cp .env.example .env

# API base path. Relative, so requests go through the Vite proxy (dev) / reverse proxy (production)
VITE_API_URL=/api/v1

# Optional: base URL of short links. When empty, the current origin is used
# (localhost:5173/shortcode in dev, https://domain.com/shortcode in production)
# VITE_SHORT_URL_BASE=
